<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_bg">

    <ImageView
        android:id="@+id/btnBack"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:padding="12dp"
        android:src="@android:drawable/ic_menu_revert"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/action_red_dark" />

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ludo Master"
        android:textColor="@color/action_red_dark"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@+id/btnBack"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/btnBack" />

    <ImageView
        android:id="@+id/btnSettings"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="16dp"
        android:padding="12dp"
        android:src="@android:drawable/ic_menu_preferences"
        app:layout_constraintBottom_toBottomOf="@+id/btnBack"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/btnBack"
        app:tint="@color/action_red_dark" />

    <com.example.ludo.board.LudoBoardView
        android:id="@+id/ludoBoard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="32dp"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTitle" />

    <ImageView
        android:id="@+id/avatarYou"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginBottom="8dp"
        android:src="@android:drawable/sym_def_app_icon"
        android:background="@drawable/bg_active_avatar_border"
        android:padding="4dp"
        app:layout_constraintBottom_toTopOf="@+id/ludoBoard"
        app:layout_constraintStart_toStartOf="@+id/ludoBoard" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="YOU"
        android:textColor="@color/action_red_dark"
        android:textSize="12sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="@+id/avatarYou"
        app:layout_constraintStart_toStartOf="@+id/avatarYou"
        app:layout_constraintTop_toBottomOf="@+id/avatarYou" />

    <ImageView
        android:id="@+id/avatarP2"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginBottom="8dp"
        android:src="@android:drawable/sym_def_app_icon"
        app:layout_constraintBottom_toTopOf="@+id/ludoBoard"
        app:layout_constraintEnd_toEndOf="@+id/ludoBoard" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Player 2"
        android:textColor="@color/text_muted_grey"
        android:textSize="12sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="@+id/avatarP2"
        app:layout_constraintStart_toStartOf="@+id/avatarP2"
        app:layout_constraintTop_toBottomOf="@+id/avatarP2" />

    <ImageView
        android:id="@+id/avatarP3"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginTop="16dp"
        android:src="@android:drawable/sym_def_app_icon"
        app:layout_constraintStart_toStartOf="@+id/ludoBoard"
        app:layout_constraintTop_toBottomOf="@+id/ludoBoard" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Opponent 2"
        android:textColor="@color/text_muted_grey"
        android:textSize="12sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="@+id/avatarP3"
        app:layout_constraintStart_toStartOf="@+id/avatarP3"
        app:layout_constraintTop_toBottomOf="@+id/avatarP3" />

    <ImageView
        android:id="@+id/avatarP4"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginTop="16dp"
        android:src="@android:drawable/sym_def_app_icon"
        app:layout_constraintEnd_toEndOf="@+id/ludoBoard"
        app:layout_constraintTop_toBottomOf="@+id/ludoBoard" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Opponent 3"
        android:textColor="@color/text_muted_grey"
        android:textSize="12sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="@+id/avatarP4"
        app:layout_constraintStart_toStartOf="@+id/avatarP4"
        app:layout_constraintTop_toBottomOf="@+id/avatarP4" />

    <com.example.ludo.board.DiceView
        android:id="@+id/diceView"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:layout_marginTop="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ludoBoard" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnRollDice"
        android:layout_width="160dp"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_roll_button"
        android:text="ROLL DICE"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/diceView" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/bottom_nav_bg"
        android:gravity="center"
        android:orientation="horizontal"
        android:weightSum="4"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:drawableTop="@android:drawable/ic_menu_send"
            android:gravity="center"
            android:text="Chat"
            android:textColor="@color/text_dark_brown"
            android:textSize="12sp"
            app:drawableTint="@color/text_dark_brown" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:drawableTop="@android:drawable/ic_menu_sort_by_size"
            android:gravity="center"
            android:text="Stats"
            android:textColor="@color/text_dark_brown"
            android:textSize="12sp"
            app:drawableTint="@color/text_dark_brown" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:drawableTop="@android:drawable/ic_menu_myplaces"
            android:gravity="center"
            android:text="Friends"
            android:textColor="@color/text_dark_brown"
            android:textSize="12sp"
            app:drawableTint="@color/text_dark_brown" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:drawableTop="@android:drawable/ic_menu_gallery"
            android:gravity="center"
            android:text="Shop"
            android:textColor="@color/text_dark_brown"
            android:textSize="12sp"
            app:drawableTint="@color/text_dark_brown" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>